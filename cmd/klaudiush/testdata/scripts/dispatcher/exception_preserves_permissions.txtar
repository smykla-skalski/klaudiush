exec git init --initial-branch=main
exec git config user.email "test@test.com"
exec git config user.name "Test User"

cp file.go staged.go
exec git add staged.go

stdin input.json
exec klaudiush --hook-type PreToolUse
stdout 'Exception EXC:GIT010 accepted'
! stdout '"permissionDecision"'
! stdout '"allow"'

-- .klaudiush/config.toml --
[exceptions]
enabled = true

[exceptions.policies.GIT010]
enabled = true
allow_exception = true
require_reason = true
min_reason_length = 5

-- file.go --
package main

func main() {}

-- input.json --
{
  "tool_name": "Bash",
  "tool_input": {
    "command": "git commit -S -m 'feat(api): add user endpoint' # EXC:GIT010:Signoff+not+required+here"
  }
}
