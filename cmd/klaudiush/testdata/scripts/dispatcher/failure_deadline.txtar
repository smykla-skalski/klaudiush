[!exec:sleep] skip
[!exec:sed] skip

exec klaudiush --hook-type PreToolUse
! stdout .

mkdir $WORK/.klaudiush/plugins
cp slow.sh $WORK/.klaudiush/plugins/slow.sh
chmod 0755 $WORK/.klaudiush/plugins/slow.sh
exec $WORK/.klaudiush/plugins/slow.sh --version
stdout '^1$'
mkdir project/.klaudiush
exec sh -c 'sed "s#HOMEDIR#$WORK#" config.toml > project/.klaudiush/config.toml'
cd project

stdin $WORK/ls.json
exec klaudiush --hook-type PreToolUse
stdout 'Validation unavailable HOOK001'
stdout 'did not answer in time'
! stdout 'permissionDecision'

stdin $WORK/ls.json
exec klaudiush --hook-type PreToolUse --failure-mode=block
stdout '"permissionDecision":"deny"'
stdout 'did not answer in time'

-- ls.json --
{"tool_name": "Bash", "tool_input": {"command": "ls"}}

-- config.toml --
[failure_policy]
mode = "warn"
deadline = "1s"

[plugins]
enabled = true

[[plugins.plugins]]
name = "slow"
type = "exec"
path = "HOMEDIR/.klaudiush/plugins/slow.sh"
timeout = "60s"

-- slow.sh --
#!/bin/sh
case "$1" in
  --info) echo '{"name":"slow","version":"1"}'; exit 0 ;;
  --version) echo 1; exit 0 ;;
esac
cat >/dev/null
sleep 10
