[!exec:git] skip
[!exec:sh] skip

env GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
cd project
exec git init -q
exec git add -A
exec git commit -qm init

stdin $WORK/pre-write.json
exec klaudiush --hook-type PreToolUse
! stdout .

stdin $WORK/stop.json
exec klaudiush --event Stop
! stdout .

cp $WORK/readme-v2.md README.md
stdin $WORK/stop.json
exec klaudiush --event Stop
! stdout .

cp $WORK/a-v2.go a.go
stdin $WORK/stop.json
exec klaudiush --event Stop
stdout '"decision":"block"'
stdout 'EVID001'
stdout 'Required check \\"tests\\" \(test\) has no passing result'
stdout 'it has not run since the files changed'
stdout 'as its own foreground command'
stdout 'evidence run tests'

stdin $WORK/pre-chained.json
exec klaudiush --hook-type PreToolUse
stdin $WORK/post-chained.json
exec klaudiush --hook-type PostToolUse
stdin $WORK/stop.json
exec klaudiush --event Stop
stdout 'it has not run since the files changed'

stdin $WORK/pre-run1.json
exec klaudiush --hook-type PreToolUse
! stdout .
stdin $WORK/failure-run1.json
exec klaudiush --hook-type PostToolUseFailure
stdin $WORK/stop.json
exec klaudiush --event Stop
stdout '"decision":"block"'
stdout 'failed: Exit code 1'
stdout 'Fix what the check reports'

stdin $WORK/pre-run2.json
exec klaudiush --hook-type PreToolUse
stdin $WORK/interrupt-run2.json
exec klaudiush --hook-type PostToolUseFailure
stdin $WORK/stop.json
exec klaudiush --event Stop
stdout 'the command was interrupted'

stdin $WORK/pre-run3.json
exec klaudiush --hook-type PreToolUse
stdin $WORK/stop.json
exec klaudiush --event Stop
stdout 'still running since'
stdout 'Wait for the running check to finish'

stdin $WORK/pre-background.json
exec klaudiush --hook-type PreToolUse
stdin $WORK/stop.json
exec klaudiush --event Stop
stdout 'it ran in the background'

stdin $WORK/pre-run4.json
exec klaudiush --hook-type PreToolUse
stdin $WORK/post-run4.json
exec klaudiush --hook-type PostToolUse
stdin $WORK/stop.json
exec klaudiush --event Stop
! stdout .

cp $WORK/a-v3.go a.go
stdin $WORK/stop.json
exec klaudiush --event Stop
stdout 'its passed result is for content that has changed since'

cp $WORK/a-v2.go a.go
stdin $WORK/stop.json
exec klaudiush --event Stop
! stdout .

stdin $WORK/stop-other.json
exec klaudiush --event Stop
! stdout .

exec klaudiush evidence status
stdout 'Evidence gate: enabled'
stdout 'claude: gated; shell runs of a check and ''klaudiush evidence run'' both count'
stdout 'codex: gated; only ''klaudiush evidence run'' counts'
stdout 'tests \(test\): sh check.sh'
stdout 'verdict: passed'

-- project/.klaudiush/config.toml --
[evidence]
enabled = true

[[evidence.checks]]
name = "tests"
commands = ["sh check.sh"]
paths = ["**/*.go"]

-- project/check.sh --
echo checked

-- project/a.go --
package a

-- project/README.md --
readme

-- a-v2.go --
package a

var X = 1

-- a-v3.go --
package a

var X = 2

-- readme-v2.md --
changed readme

-- pre-write.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Write","tool_use_id":"w1","tool_input":{"file_path":"a.go","content":"package a\n"}}

-- stop.json --
{"session_id":"s1","hook_event_name":"Stop","stop_hook_active":false}

-- stop-other.json --
{"session_id":"s2","hook_event_name":"Stop","stop_hook_active":false}

-- pre-chained.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_use_id":"c1","tool_input":{"command":"sh check.sh || true"}}

-- post-chained.json --
{"session_id":"s1","hook_event_name":"PostToolUse","tool_name":"Bash","tool_use_id":"c1","tool_input":{"command":"sh check.sh || true"},"tool_response":{"stdout":"PASS all tests passed"}}

-- pre-run1.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_use_id":"t1","tool_input":{"command":"sh check.sh"}}

-- failure-run1.json --
{"session_id":"s1","hook_event_name":"PostToolUseFailure","tool_name":"Bash","tool_use_id":"t1","tool_input":{"command":"sh check.sh"},"error":"Exit code 1"}

-- pre-run2.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_use_id":"t2","tool_input":{"command":"sh check.sh"}}

-- interrupt-run2.json --
{"session_id":"s1","hook_event_name":"PostToolUseFailure","tool_name":"Bash","tool_use_id":"t2","tool_input":{"command":"sh check.sh"},"error":"Interrupted","is_interrupt":true}

-- pre-run3.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_use_id":"t3","tool_input":{"command":"sh check.sh"}}

-- pre-background.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_use_id":"bg","tool_input":{"command":"sh check.sh","run_in_background":true}}

-- pre-run4.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_use_id":"t4","tool_input":{"command":"sh check.sh"}}

-- post-run4.json --
{"session_id":"s1","hook_event_name":"PostToolUse","tool_name":"Bash","tool_use_id":"t4","tool_input":{"command":"sh check.sh"},"tool_response":{"stdout":"checked","stderr":"","interrupted":false}}
