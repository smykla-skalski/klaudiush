{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":gitSignOff",
    ":dependencyDashboard",
    ":label(dependencies)",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlertsWithAdditionalLabel(kind/security)",
    ":automergeMinor",
    ":automergeDigest",
    ":automergeLinters",
    ":automergeTesters",
    ":prConcurrentLimit20",
    "helpers:pinGitHubActionDigests",
    "security:openssf-scorecard",
    "group:linters",
    "customManagers:githubActionsVersions"
  ],
  "ignorePaths": [
    "**/tmp/**",
    ".github/workflows/smyklot-pr-commands.yml",
    ".github/workflows/smyklot-poll.yml"
  ],
  "osvVulnerabilityAlerts": true,
  "gitIgnoredAuthors": ["205507218+smyklot[bot]@users.noreply.github.com"],
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "addLabels": ["area/ci"],
      "commitMessageTopic": "{{depName}} action",
      "description": "GitHub Actions dependencies",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Group Go tool dependencies",
      "groupName": "Go tooling",
      "matchDepTypes": ["require"],
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^golang.org/x/tools/"]
    },
    {
      "description": [
        " Group dependency bumps from selected GitHub sources into a single PR across managers",
        " (e.g., mise and gomod) to avoid separate PRs per manager"
      ],
      "matchSourceUrls": ["https://github.com/{onsi/ginkgo,golangci/golangci-lint}"],
      "groupName": "{{{replace 'https://github\\.com/[a-z-]+/' '' sourceUrl}}}"
    },
    {
      "description": "Group Go version updates from gomod and mise into a single PR",
      "groupName": "go version",
      "matchDepNames": ["go"],
      "matchManagers": ["gomod", "mise"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Smyklot action managed by sync-smyklot workflow",
      "enabled": false,
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["smykla-skalski/smyklot"]
    },
    {"description":"Group golang.org/x Go modules","groupName":"golang.org/x modules","matchDepTypes":["require"],"matchManagers":["gomod"],"matchPackageNames":["/^golang\\.org\\/x\\//"]},
    {"description":"Group Charm Go modules","groupName":"Charm modules","matchManagers":["gomod"],"matchPackageNames":["/^charm\\.land\\//"]},
    {"description":"Update go-git only on Monday mornings (using pinned commit SHAs as v6 is not yet GA)","extends":["schedule:earlyMondays"],"matchManagers":["gomod"],"matchPackageNames":["github.com/go-git/go-git/v6"]}
  ],
  "vulnerabilityAlerts": {
    "automerge": true
  }
}
